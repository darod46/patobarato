TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=data/reader.session
TELEGRAM_BOT_TOKEN=
TARGET_CHANNEL=@patobarato
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
AFFILIATE_TAG=patobarato-21
DEFAULT_COUNTRY=ES
REPUBLISH_AFTER_DAYS=7
STALE_AFTER_MINUTES=30
SOURCES_REFRESH_SECONDS=300
HTTP_TIMEOUT_SECONDS=10.0
# Pause in seconds between product requests when refreshing guide prices
GUIDE_PRICE_DELAY_SECONDS=1.5
# AliExpress Portals (the store is only enabled when the three are set)
# The `promos` command and the `event_promos` runner also need all three.
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
# Awin publisher id and API token (shared by all Awin stores)
AWIN_PUBLISHER_ID=
AWIN_API_TOKEN=
# Awin merchants as JSON {"store": merchant_id}. Leave commented to use the defaults
# (pccomponentes, mediamarkt, elcorteingles without merchant id); an empty value is invalid JSON:
# omit the variable or use {}.
# The value REPLACES the defaults: list every Awin store, not only the new one. In production,
# with the tyre guides, use the merged map (null = store without merchant id):
# AWIN_MERCHANTS={"pccomponentes": 1234, "mediamarkt": 5678, "elcorteingles": 9012, "neumaticos": 11552}
# Admin portal: base URL of the admin app (invite emails redirect to ADMIN_URL/auth/confirm)
ADMIN_URL=
# Public website revalidation endpoint, e.g. https://www.patobarato.com/api/revalidate (must be the canonical www host: the bot does not follow redirects), and its shared secret
WEB_REVALIDATE_URL=
REVALIDATE_SECRET=
# Public website, used for the guide links and covers announced in the channel
SITE_URL=https://www.patobarato.com
# Mientras Amazon Afiliados revisa la web, los posts de Amazon enlazan a la ficha de la web (true).
# Tras la aprobación: AMAZON_LINKS_TO_WEB=false (y en la web, FLAGS en web/src/lib/flags.ts; en el admin,
# AMAZON_LINKS_TO_WEB en admin/src/lib/web-links.ts).
AMAZON_LINKS_TO_WEB=true
# DeepSeek (platform.deepseek.com): descripción breve y categoría de cada producto en su ficha de la web.
# Sin clave no se generan. Coste orientativo: 1-2 USD por cada 4.000 productos.
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash

# Bot de alertas de precio (@patobaratobot), token de @BotFather. Sin token no se arranca.
ALERTS_BOT_TOKEN=
