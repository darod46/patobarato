TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=data/reader.session
TELEGRAM_BOT_TOKEN=
TARGET_CHANNEL=@patobarato
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
AFFILIATE_TAG=patobarato-21
DEFAULT_COUNTRY=ES
REPUBLISH_AFTER_DAYS=7
STALE_AFTER_MINUTES=30
SOURCES_REFRESH_SECONDS=300
HTTP_TIMEOUT_SECONDS=10.0
# Pause in seconds between product requests when refreshing guide prices
GUIDE_PRICE_DELAY_SECONDS=1.5
# AliExpress Portals (the store is only enabled when the three are set)
# The `promos` command and the `event_promos` runner also need all three.
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
# Awin publisher id and API token (shared by all Awin stores)
AWIN_PUBLISHER_ID=
AWIN_API_TOKEN=
# Awin merchants as JSON {"store": merchant_id}. Leave commented to use the defaults
# (pccomponentes, mediamarkt, elcorteingles without merchant id); an empty value is invalid JSON:
# omit the variable or use {}.
# AWIN_MERCHANTS={"pccomponentes": 1234}
# Admin portal: base URL of the admin app (invite emails redirect to ADMIN_URL/auth/confirm)
ADMIN_URL=
# Public website revalidation endpoint, e.g. https://patobarato.es/api/revalidate, and its shared secret
WEB_REVALIDATE_URL=
REVALIDATE_SECRET=
