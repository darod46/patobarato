TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=data/reader.session
TELEGRAM_BOT_TOKEN=
TARGET_CHANNEL=@patobarato
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
AFFILIATE_TAG=patobarato-21
DEFAULT_COUNTRY=ES
REPUBLISH_AFTER_DAYS=7
STALE_AFTER_MINUTES=30
SOURCES_REFRESH_SECONDS=300
HTTP_TIMEOUT_SECONDS=10.0
# AliExpress Portals (the store is only enabled when the three are set)
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
